# SilentSum environment configuration (copy to .env and adjust).
# Nothing here is required: with no .env the app runs fully offline with Firebase disabled.

# dev | prod. Selects which Firebase config files are used. Default: dev for debug builds.
SILENTSUM_ENV=dev

# Paths (relative to the project root) to the Firebase native config files.
# When BOTH files exist Firebase is compiled in and enabled; when absent the app builds without Firebase.
# Keep these files out of git (they are ignored by default).
GOOGLE_SERVICES_JSON=./config/firebase/google-services.dev.json
GOOGLE_SERVICES_PLIST=./config/firebase/GoogleService-Info.dev.plist

# Firebase App Check debug token for DEV builds. Any UUID will do -- generate one with
# `node -e "console.log(require('crypto').randomUUID())"` -- and register that exact value in the
# Firebase console under App Check > Apps > Manage debug tokens.
#
# Leaving it empty is NOT harmless. The native SDK then mints a random debug secret on every
# install, the console has never seen it, and App Check refuses every Firestore read and Storage
# upload. Messaging reports that as "Messaging is not available in this build." -- a sentence about
# the build, for a server refusal -- so the cause is very hard to see from the app.
#
# Dev only: app.config.ts refuses to publish this for a prod build, because everything in `extra`
# is plain text inside the APK and a registered debug token is a project-wide App Check bypass.
APP_CHECK_DEBUG_TOKEN=

# Android application id / iOS bundle identifier (change if you register your own Firebase apps).
APP_ID=com.kruegerco.silentsum

# --- Customer service (optional) -------------------------------------------------------------
# With any of the three below empty, the customer service screen says it is not set up in this
# build. Nothing else changes: the vault never needed a network.
#
# THERE IS NO API KEY HERE, AND THERE MUST NEVER BE ONE. Everything in this file reaches the app
# through the Expo config's `extra`, which is plain text in the APK -- a mail provider's bearer
# token here is published with every build. An earlier version of this project did exactly that.
#
# SUPPORT_ENDPOINT is the deployed `silentsumSupportRelay` function, which holds the provider's key
# in Secret Manager and chooses the recipient itself:
#
#     https://<region>-<firebase-project-id>.cloudfunctions.net/silentsumSupportRelay
#
# A mail provider's own API host is REFUSED here (src/support/supportConfig.ts), so this cannot be
# turned back into a direct call by editing this file.
SUPPORT_ENDPOINT=
# The sender, and the inbox as the app SHOWS it. The relay sends using its own copies of these
# (SILENTSUM_SUPPORT_FROM / SILENTSUM_SUPPORT_TO in functions/.env) and discards what the app sends,
# so keep the two in step or the app will name an address that never receives anything.
# Format: SUPPORT_FROM=Calculator <support@your-domain.example>
SUPPORT_FROM=
SUPPORT_TO=

# --- Recovery codes (optional) -----------------------------------------------------------
# The PUBLIC half of an Ed25519 keypair, base64, 32 bytes. Generate one with:
#
#     node scripts/recovery-code.js keygen
#
# It prints both halves. The public half goes here and ships in the bundle, which is fine:
# it can only VERIFY a code. Keep the private half off this machine and out of git -- anyone
# holding it can mint a code for any installation.
#
# Leave empty and no code is ever accepted: the entry point does not appear at all.
RECOVERY_PUBLIC_KEY=

# --- Firebase Storage (optional) ---------------------------------------------------------------
# The bucket SilentSum keeps encrypted backup blobs in, WITHOUT the gs:// prefix. Must be a bucket
# used by nothing else: Storage rules are per-bucket and OR together within one, so a shared
# bucket's broader grants cannot be narrowed for SilentSum's paths. Empty (the default) means
# cloud backup is not offered at all, which is the safe state.
FIREBASE_STORAGE_BUCKET=

# --- Purchases: SilentSum Pro and SilentSum Cloud (optional) --------------------------------
# Payments run through PayMongo, but ONLY from the project's Cloud Functions (functions/), which
# hold the PayMongo secret and webhook keys as Firebase secrets. Nothing secret goes here, and
# nothing PayMongo-related is ever compiled into the app.
#
# Billing needs Firebase AND the Storage bucket above (entitlements are read through the same
# cloud backend). Without them the app sells nothing and every Pro gate stays open.
#
# BILLING_ENABLED=false builds an app that never offers a purchase.
BILLING_ENABLED=true
# Where the functions are deployed. Empty = https://us-central1-<firebase-project-id>.cloudfunctions.net
BILLING_FUNCTIONS_URL=
