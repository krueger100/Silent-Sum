{
  "name": "silentsum-functions",
  "version": "0.1.0",
  "private": true,
  "description": "SilentSum billing backend: PayMongo checkout sessions and webhooks in, Firestore entitlements out.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run typecheck && npm test",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions:silentsum"
  },
  "dependencies": {
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "typescript": "~5.9.3"
  }
}
