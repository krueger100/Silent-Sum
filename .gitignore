# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native (generated by `npx expo prebuild`; regenerate, do not commit). Anchored to the root on
# purpose: an unanchored `android/` also swallows `modules/*/android`, which is hand-written source
# for the local Expo modules and the one thing in this repo that prebuild does NOT regenerate.
/android/
/ios/

# Gradle output inside a local module, which is generated and large.
modules/*/android/build/
modules/*/android/.cxx/

# Metro / build caches
.metro-health-check*
*.tsbuildinfo
coverage/

# Environment and Firebase configuration (never commit)
.env
.env.*
!.env.example
google-services.json
GoogleService-Info.plist
firebase/**/google-services*.json
firebase/**/GoogleService-Info*.plist
config/firebase/*.json
config/firebase/*.plist
!config/firebase/README.md

# Signing (never commit)
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision
*.pem
*.key
credentials.json
key.properties
# Read at build time by plugins/withReleaseSigning.js. Lives in the project root rather than
# android/, which `expo prebuild` deletes. The example carries the key names and no values.
keystore.properties
!keystore.properties.example

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.orig.*
*.log
npm-debug.*
yarn-error.*
